# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Square Configuration
# 1. Get these from your Square Developer Dashboard (https://developer.squareup.com/apps)
# 2. Add them to the 'Settings > Secrets' menu in AI Studio.

# Your Square Sandbox/Production Access Token (Keep this private - do not prefix with VITE_)
SQUARE_ACCESS_TOKEN="EAAA..."

# Your Square Sandbox/Production Application ID (Exposed to client for payments)
VITE_SQUARE_APP_ID="sandbox-sq0idb-..."

# Your Square Location ID
SQUARE_LOCATION_ID="L..."
VITE_SQUARE_LOCATION_ID="L..."

# Set to 'sandbox' for testing, 'production' for live payments
SQUARE_ENVIRONMENT="sandbox"

# Email Configuration (for Quote Requests)
# 1. Add these to the 'Settings > Secrets' menu in AI Studio.
# 2. For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
EMAIL_SERVICE="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
ADMIN_EMAIL="admin@example.com"

# Google Business Profile Reviews
# 1. Get an API key from Google Cloud Console (Maps JavaScript API / Places API)
# 2. Get your Place ID using the Place ID Finder (https://developers.google.com/maps/documentation/places/web-service/place-id)
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACE_ID=""

# Google Analytics (GA4)
# Get your Measurement ID (G-XXXXXXXXXX) from Google Analytics
VITE_GOOGLE_ANALYTICS_ID="G-NTM24QWD2C"
