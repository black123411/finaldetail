{
  "name": "bryans-detailing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server/index.ts",
    "build": "vite build",
    "postbuild": "tsx scripts/generate-route-meta.mjs",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "start": "npx tsx --tsconfig tsconfig.server.json server/index.ts",
    "worker:dev": "npx --yes wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "npx --yes wrangler deploy --config worker/wrangler.jsonc",
    "lint": "echo skip"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "firebase": "^12.16.0",
    "lucide-react": "^0.378.0",
    "motion": "^11.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.23.0",
    "remark-gfm": "^4.0.1",
    "square": "^37.1.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vite": "^6.0.0"
  }
